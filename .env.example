# Server-only provider for portfolio chat and Novaa prompts.
# Keep this out of browser code; configure the key in the hosting platform's protected secret store.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Server-only contact-form delivery through Resend. Add/verify the sender domain before enabling.
RESEND_API_KEY=
CONTACT_EMAIL_ENABLED=false
