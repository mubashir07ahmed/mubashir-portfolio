# Server-side AI provider selection: auto, groq, openai, gemini, or manus
# The live mubashirr.in deployment currently uses Groq.
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MANUS_API_URL=
MANUS_API_KEY=
